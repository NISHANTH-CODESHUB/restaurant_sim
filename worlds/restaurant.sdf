<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="restaurant">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Ground Floor Assembly -->
    <include>
      <name>ground_floor_inst</name>
      <uri>model://ground_floor</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- First Floor Assembly -->
    <include>
      <name>first_floor_inst</name>
      <uri>model://first_floor</uri>
      <pose>0 0 3.5 0 0 0</pose>
    </include>

    <!-- Lift Assembly (now STATIC - no moving cabin/doors, no controller plugin).
         Placed at the center of the back-left bay, on the same spot the staircase
         used to occupy, so it sits on the main pathway. Yaw -1.5708 (-90 deg) turns
         the lift to face +X, i.e. its doors open directly onto that pathway. The
         cabin is parked "arrived" at the first floor (doors open there), not the
         ground floor - see models/_fixtures/lift_assembly/model.sdf for details. -->
    <include>
      <name>lift_assembly_inst</name>
      <uri>model://_fixtures/lift_assembly</uri>
      <pose>-10 0 0 0 0 -1.5708</pose>
    </include>

  </world>
</sdf>
