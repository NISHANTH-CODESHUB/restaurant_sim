    <include><name>f1_pendant_light_5</name><uri>model://_lighting/pendant_light</uri><pose>-6 -4.5 3.4 0 0 0</pose></include>
    <include><name>f1_pendant_light_6</name><uri>model://_lighting/pendant_light</uri><pose>-2 -4.5 3.4 0 0 0</pose></include>
    <include><name>f1_pendant_light_7</name><uri>model://_lighting/pendant_light</uri><pose>2 -4.5 3.4 0 0 0</pose></include>
    <include><name>f1_pendant_light_8</name><uri>model://_lighting/pendant_light</uri><pose>6 -4.5 3.4 0 0 0</pose></include>

  </model>
