    <include><name>corridor_s_wall_4</name><uri>model://_components/wall_segment_4m</uri><pose>6 -1.0 0 0 0 0</pose></include>

    <!-- Cabin Entry Doors (pre-opened, leading from corridor into cabins) -->
    <!-- North Cabin Doors -->
    <include><name>cabin_door_1</name><uri>model://_components/door_single</uri><pose>-6 1.0 0 0 0 0</pose></include>
    <include><name>cabin_door_2</name><uri>model://_components/door_single</uri><pose>-2 1.0 0 0 0 0</pose></include>
    <include><name>cabin_door_3</name><uri>model://_components/door_single</uri><pose>2 1.0 0 0 0 0</pose></include>
    <include><name>cabin_door_4</name><uri>model://_components/door_single</uri><pose>6 1.0 0 0 0 0</pose></include>
    <!-- South Cabin Doors -->
    <include><name>cabin_door_5</name><uri>model://_components/door_single</uri><pose>-6 -1.0 0 0 0 3.14159</pose></include>
    <include><name>cabin_door_6</name><uri>model://_components/door_single</uri><pose>-2 -1.0 0 0 0 3.14159</pose></include>
    <include><name>cabin_door_7</name><uri>model://_components/door_single</uri><pose>2 -1.0 0 0 0 3.14159</pose></include>
    <include><name>cabin_door_8</name><uri>model://_components/door_single</uri><pose>6 -1.0 0 0 0 3.14159</pose></include>

    <!-- Cabin Division Walls (North-South partition walls) -->
    <!-- North Division Walls (y = 1.0 to 8.0) -->
    <include><name>div_wall_n0_a</name><uri>model://_components/wall_segment_4m</uri><pose>-8 3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_n0_b</name><uri>model://_components/wall_segment_4m</uri><pose>-8 6.0 0 0 0 1.5708</pose></include>

    <include><name>div_wall_n1_a</name><uri>model://_components/wall_segment_4m</uri><pose>-4 3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_n1_b</name><uri>model://_components/wall_segment_4m</uri><pose>-4 6.0 0 0 0 1.5708</pose></include>

    <include><name>div_wall_n2_a</name><uri>model://_components/wall_segment_4m</uri><pose>0 3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_n2_b</name><uri>model://_components/wall_segment_4m</uri><pose>0 6.0 0 0 0 1.5708</pose></include>

    <include><name>div_wall_n3_a</name><uri>model://_components/wall_segment_4m</uri><pose>4 3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_n3_b</name><uri>model://_components/wall_segment_4m</uri><pose>4 6.0 0 0 0 1.5708</pose></include>

    <include><name>div_wall_n4_a</name><uri>model://_components/wall_segment_4m</uri><pose>8 3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_n4_b</name><uri>model://_components/wall_segment_4m</uri><pose>8 6.0 0 0 0 1.5708</pose></include>

    <!-- South Division Walls (y = -8.0 to -1.0) -->
    <include><name>div_wall_s0_a</name><uri>model://_components/wall_segment_4m</uri><pose>-8 -3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_s0_b</name><uri>model://_components/wall_segment_4m</uri><pose>-8 -6.0 0 0 0 1.5708</pose></include>

    <include><name>div_wall_s1_a</name><uri>model://_components/wall_segment_4m</uri><pose>-4 -3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_s1_b</name><uri>model://_components/wall_segment_4m</uri><pose>-4 -6.0 0 0 0 1.5708</pose></include>

    <include><name>div_wall_s2_a</name><uri>model://_components/wall_segment_4m</uri><pose>0 -3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_s2_b</name><uri>model://_components/wall_segment_4m</uri><pose>0 -6.0 0 0 0 1.5708</pose></include>

    <include><name>div_wall_s3_a</name><uri>model://_components/wall_segment_4m</uri><pose>4 -3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_s3_b</name><uri>model://_components/wall_segment_4m</uri><pose>4 -6.0 0 0 0 1.5708</pose></include>

    <include><name>div_wall_s4_a</name><uri>model://_components/wall_segment_4m</uri><pose>8 -3.0 0 0 0 1.5708</pose></include>
    <include><name>div_wall_s4_b</name><uri>model://_components/wall_segment_4m</uri><pose>8 -6.0 0 0 0 1.5708</pose></include>

    <!-- East-most Storage / Utility Room Doors (at x = 8.0) -->
    <include><name>utility_door_n</name><uri>model://_components/door_single</uri><pose>8 2.0 0 0 0 1.5708</pose></include>
    <include><name>utility_door_s</name><uri>model://_components/door_single</uri><pose>8 -2.0 0 0 0 1.5708</pose></include>

    <!-- Cabin Interior Bedroom Layout (converted from dining to bedrooms) -->
    <!-- Cabin 1 (x = -6, y = 4.5) -->
    <include><name>c1_bed</name><uri>model://_furniture/bed_single</uri><pose>-6 4.5 0 0 0 1.5708</pose></include>

    <!-- Cabin 2 (x = -2, y = 4.5) -->
    <include><name>c2_bed</name><uri>model://_furniture/bed_single</uri><pose>-2 4.5 0 0 0 1.5708</pose></include>

    <!-- Cabin 3 (x = 2, y = 4.5) -->
    <include><name>c3_bed</name><uri>model://_furniture/bed_single</uri><pose>2 4.5 0 0 0 1.5708</pose></include>

    <!-- Cabin 4 (x = 6, y = 4.5) -->
    <include><name>c4_bed</name><uri>model://_furniture/bed_single</uri><pose>6 4.5 0 0 0 1.5708</pose></include>
    <!-- Cabin 5 (x = -6, y = -4.5) -->
    <include><name>c5_bed</name><uri>model://_furniture/bed_single</uri><pose>-6 -4.5 0 0 0 1.5708</pose></include>

    <!-- Cabin 6 (x = -2, y = -4.5) -->
    <include><name>c6_bed</name><uri>model://_furniture/bed_single</uri><pose>-2 -4.5 0 0 0 1.5708</pose></include>

    <!-- Cabin 7 (x = 2, y = -4.5) -->
    <include><name>c7_bed</name><uri>model://_furniture/bed_single</uri><pose>2 -4.5 0 0 0 1.5708</pose></include>

    <!-- Cabin 8 (x = 6, y = -4.5) -->
    <include><name>c8_bed</name><uri>model://_furniture/bed_single</uri><pose>6 -4.5 0 0 0 1.5708</pose></include>

    <!-- Plants removed from first floor (were a navigation/visual disturbance) -->

    <!-- Ceiling Lights (First Floor Ceiling at z = 3.4m) -->
    <!-- Corridor Lighting -->
    <include><name>f1_light_corr_1</name><uri>model://_lighting/ceiling_light_panel</uri><pose>-9 0 3.4 0 0 0</pose></include>
    <include><name>f1_light_corr_2</name><uri>model://_lighting/ceiling_light_panel</uri><pose>-5 0 3.4 0 0 0</pose></include>
    <include><name>f1_light_corr_3</name><uri>model://_lighting/ceiling_light_panel</uri><pose>-1 0 3.4 0 0 0</pose></include>
    <include><name>f1_light_corr_4</name><uri>model://_lighting/ceiling_light_panel</uri><pose>3 0 3.4 0 0 0</pose></include>
    <include><name>f1_light_corr_5</name><uri>model://_lighting/ceiling_light_panel</uri><pose>7 0 3.4 0 0 0</pose></include>

    <!-- Cabin Pendant Lights -->
    <include><name>f1_pendant_light_1</name><uri>model://_lighting/pendant_light</uri><pose>-6 4.5 3.4 0 0 0</pose></include>
    <include><name>f1_pendant_light_2</name><uri>model://_lighting/pendant_light</uri><pose>-2 4.5 3.4 0 0 0</pose></include>
    <include><name>f1_pendant_light_3</name><uri>model://_lighting/pendant_light</uri><pose>2 4.5 3.4 0 0 0</pose></include>
