<?xml version="1.0" ?>
<!--
  lift_assembly | Module C - STATIC Fixture (converted from the dynamic version)
  No moving parts, no controller plugin. The cabin is permanently "parked" at the
  first floor, with the first-floor landing doors and the cabin doors both shown
  fully open (so it reads as "arrived and open" facing the first-floor pathway).
  The ground-floor landing doors are shown closed, since the cabin is not there.

  Coordinate frame matches the original lift_shaft/lift_cabin models exactly, so
  local +Y is the "front" of the lift (the side the doors are on). Whatever yaw
  this model is included with in the world file determines which way the doors
  face - it is included facing +X (world yaw -1.5708) so it opens onto the
  first-floor pathway/corridor.

  Ground floor door opening: z 0.0 -> 2.1 (center 1.05) - CLOSED
  First floor door opening:  z 3.5 -> 5.6 (center 4.55) - OPEN
  Cabin: fixed at z = 3.5 (arrived at first floor), doors OPEN to match.
  Clear opening width: 1.7 m -> two 0.85 m panels, open panels slid fully
  into the side-wall pockets.
-->
<sdf version="1.6">
  <model name="lift_assembly">
    <static>true</static>

    <!-- ============================================================= -->
    <!-- SHAFT (fixed geometry, identical to the original) -->
    <!-- ============================================================= -->
    <link name="shaft_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Left Wall (Solid) -->
      <collision name="left_wall_collision">
        <pose>-1.05 0 3.5 0 0 0</pose>
        <geometry><box><size>0.1 2.2 7.0</size></box></geometry>
      </collision>
      <visual name="left_wall_visual">
        <pose>-1.05 0 3.5 0 0 0</pose>
        <geometry><box><size>0.1 2.2 7.0</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>

      <!-- Right Wall (Solid) -->
      <collision name="right_wall_collision">
        <pose>1.05 0 3.5 0 0 0</pose>
        <geometry><box><size>0.1 2.2 7.0</size></box></geometry>
      </collision>
      <visual name="right_wall_visual">
        <pose>1.05 0 3.5 0 0 0</pose>
        <geometry><box><size>0.1 2.2 7.0</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>

      <!-- Back Wall (Solid) -->
      <collision name="back_wall_collision">
        <pose>0 -1.05 3.5 0 0 0</pose>
        <geometry><box><size>2.0 0.1 7.0</size></box></geometry>
      </collision>
      <visual name="back_wall_visual">
        <pose>0 -1.05 3.5 0 0 0</pose>
        <geometry><box><size>2.0 0.1 7.0</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>

      <!-- Front Wall posts + beams (with door openings) -->
      <collision name="front_left_post_collision">
        <pose>-0.95 1.05 3.5 0 0 0</pose>
        <geometry><box><size>0.2 0.1 7.0</size></box></geometry>
      </collision>
      <visual name="front_left_post_visual">
        <pose>-0.95 1.05 3.5 0 0 0</pose>
        <geometry><box><size>0.2 0.1 7.0</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>

      <collision name="front_right_post_collision">
        <pose>0.95 1.05 3.5 0 0 0</pose>
        <geometry><box><size>0.2 0.1 7.0</size></box></geometry>
      </collision>
      <visual name="front_right_post_visual">
        <pose>0.95 1.05 3.5 0 0 0</pose>
        <geometry><box><size>0.2 0.1 7.0</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>

      <collision name="front_mid_beam_collision">
        <pose>0 1.05 2.8 0 0 0</pose>
        <geometry><box><size>1.7 0.1 1.4</size></box></geometry>
      </collision>
      <visual name="front_mid_beam_visual">
        <pose>0 1.05 2.8 0 0 0</pose>
        <geometry><box><size>1.7 0.1 1.4</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>

      <collision name="front_top_beam_collision">
        <pose>0 1.05 6.3 0 0 0</pose>
        <geometry><box><size>1.7 0.1 1.4</size></box></geometry>
      </collision>
      <visual name="front_top_beam_visual">
        <pose>0 1.05 6.3 0 0 0</pose>
        <geometry><box><size>1.7 0.1 1.4</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>

      <!-- ============================================================= -->
      <!-- GROUND FLOOR LANDING DOORS - CLOSED (cabin isn't here) -->
      <!-- ============================================================= -->
      <collision name="ground_door_left_collision">
        <pose>-0.425 1.0 1.05 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
      </collision>
      <visual name="ground_door_left_visual">
        <pose>-0.425 1.0 1.05 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
        <material><ambient>0.55 0.56 0.58 1</ambient><diffuse>0.62 0.63 0.65 1</diffuse><specular>0.75 0.75 0.77 1</specular></material>
      </visual>

      <collision name="ground_door_right_collision">
        <pose>0.425 1.0 1.05 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
      </collision>
      <visual name="ground_door_right_visual">
        <pose>0.425 1.0 1.05 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
        <material><ambient>0.55 0.56 0.58 1</ambient><diffuse>0.62 0.63 0.65 1</diffuse><specular>0.75 0.75 0.77 1</specular></material>
      </visual>

      <!-- ============================================================= -->
      <!-- FIRST FLOOR LANDING DOORS - OPEN (slid fully into the side-wall
           pockets), since the cabin has "arrived" here -->
      <!-- ============================================================= -->
      <collision name="first_door_left_collision">
        <pose>-1.275 1.0 4.55 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
      </collision>
      <visual name="first_door_left_visual">
        <pose>-1.275 1.0 4.55 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
        <material><ambient>0.55 0.56 0.58 1</ambient><diffuse>0.62 0.63 0.65 1</diffuse><specular>0.75 0.75 0.77 1</specular></material>
      </visual>

      <collision name="first_door_right_collision">
        <pose>1.275 1.0 4.55 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
      </collision>
      <visual name="first_door_right_visual">
        <pose>1.275 1.0 4.55 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
        <material><ambient>0.55 0.56 0.58 1</ambient><diffuse>0.62 0.63 0.65 1</diffuse><specular>0.75 0.75 0.77 1</specular></material>
      </visual>
    </link>

    <!-- ============================================================= -->
    <!-- CABIN - fixed permanently at the first floor level (z = 3.5) -->
    <!-- ============================================================= -->
    <link name="cabin_link">
      <pose>0 0 3.5 0 0 0</pose>

      <collision name="floor_collision">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><box><size>1.8 1.8 0.05</size></box></geometry>
      </collision>
      <visual name="floor_visual">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><box><size>1.8 1.8 0.05</size></box></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>

      <collision name="left_wall_collision">
        <pose>-0.875 0 1.2 0 0 0</pose>
        <geometry><box><size>0.05 1.8 2.3</size></box></geometry>
      </collision>
      <visual name="left_wall_visual">
        <pose>-0.875 0 1.2 0 0 0</pose>
        <geometry><box><size>0.05 1.8 2.3</size></box></geometry>
        <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse><specular>0.7 0.7 0.72 1</specular></material>
      </visual>

      <collision name="right_wall_collision">
        <pose>0.875 0 1.2 0 0 0</pose>
        <geometry><box><size>0.05 1.8 2.3</size></box></geometry>
      </collision>
      <visual name="right_wall_visual">
        <pose>0.875 0 1.2 0 0 0</pose>
        <geometry><box><size>0.05 1.8 2.3</size></box></geometry>
        <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse><specular>0.7 0.7 0.72 1</specular></material>
      </visual>

      <collision name="back_wall_collision">
        <pose>0 -0.875 1.2 0 0 0</pose>
        <geometry><box><size>1.8 0.05 2.3</size></box></geometry>
      </collision>
      <visual name="back_wall_visual">
        <pose>0 -0.875 1.2 0 0 0</pose>
        <geometry><box><size>1.8 0.05 2.3</size></box></geometry>
        <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse><specular>0.7 0.7 0.72 1</specular></material>
      </visual>

      <collision name="roof_collision">
        <pose>0 0 2.375 0 0 0</pose>
        <geometry><box><size>1.8 1.8 0.05</size></box></geometry>
      </collision>
      <visual name="roof_visual">
        <pose>0 0 2.375 0 0 0</pose>
        <geometry><box><size>1.8 1.8 0.05</size></box></geometry>
        <material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
      </visual>

      <visual name="light_panel">
        <pose>0 0 2.34 0 0 0</pose>
        <geometry><box><size>0.5 0.5 0.02</size></box></geometry>
        <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse><emissive>1.0 1.0 1.0 1</emissive></material>
      </visual>

      <!-- Cabin doors - OPEN, slid fully into the cabin's own side walls -->
      <collision name="cabin_door_left_collision">
        <pose>-0.85 0.85 1.05 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
      </collision>
      <visual name="cabin_door_left_visual">
        <pose>-0.85 0.85 1.05 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
        <material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.72 0.72 0.75 1</diffuse><specular>0.8 0.8 0.82 1</specular></material>
      </visual>

      <collision name="cabin_door_right_collision">
        <pose>0.85 0.85 1.05 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
      </collision>
      <visual name="cabin_door_right_visual">
        <pose>0.85 0.85 1.05 0 0 0</pose>
        <geometry><box><size>0.85 0.06 2.1</size></box></geometry>
        <material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.72 0.72 0.75 1</diffuse><specular>0.8 0.8 0.82 1</specular></material>
      </visual>
    </link>

  </model>
</sdf>
