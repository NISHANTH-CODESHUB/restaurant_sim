    <!-- ===================== HANDRAIL (visual only, both flights outer edge) ===================== -->
    <link name="handrail">
      <!-- Flight A outer rail (Y=0.02), rising: walking line runs (0,0)->(3.0,1.65),
           rail offset +0.9m vertically above the pitch line, centered on the run -->
      <visual name="rail_a_vis"><pose>1.5 0.03 1.725 0 -0.5 0</pose>
        <geometry><box><size>3.4 0.05 0.05</size></box></geometry>
        <material><ambient>0.10 0.10 0.11 1</ambient><diffuse>0.16 0.16 0.17 1</diffuse><specular>0.40 0.40 0.42 1</specular></material></visual>
      <!-- Flight B outer rail (Y=2.48), rising the other way: walking line runs
           (2.7,1.65)->(-0.3,3.30), rail offset +0.9m vertically above the pitch line -->
      <visual name="rail_b_vis"><pose>1.2 2.47 3.375 0 0.5 0</pose>
        <geometry><box><size>3.4 0.05 0.05</size></box></geometry>
        <material><ambient>0.10 0.10 0.11 1</ambient><diffuse>0.16 0.16 0.17 1</diffuse><specular>0.40 0.40 0.42 1</specular></material></visual>
