<?xml version="1.0" ?>
<!--
  staircase | Module D - Fixtures
  U-return stair rising 3.30 m (to first-floor level).
  Total 20 risers @ 0.165 m = 3.30 m. Tread 0.30 m. Flight width 1.2 m.
    Flight A: steps 1..10 going +X (0.165 -> 1.65 m), along Y in [0,1.2]
    Landing:  at 1.65 m, 1.2 x 1.2 m
    Flight B: steps 11..20 going -X (1.65 -> 3.30 m), along Y in [1.3,2.5]
  Origin: bottom of Flight A, corner. Footprint ~ 3.0 (X) x 2.5 (Y).
  R5: each step is a single box (visual doubles as collision geometry).
-->
<sdf version="1.6">
  <model name="staircase">
    <static>true</static>

    <!-- ===================== FLIGHT A (steps 1..10, +X, Y 0..1.2) ===================== -->
    <link name="flight_a">
      <!-- Step template repeated; tread 0.30, rise 0.165, top of step n at n*0.165 -->
      <!-- Step 1 -->
      <collision name="a1_col"><pose>0.15 0.6 0.0825 0 0 0</pose><geometry><box><size>0.30 1.2 0.165</size></box></geometry></collision>
