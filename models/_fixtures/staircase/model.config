<?xml version="1.0"?>
<model>
  <name>staircase</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author><name>Restaurant Sim Team</name><email>sim@restaurant.local</email></author>
  <description>
    Reusable 2-flight staircase (U-return) rising 3.30 m to first floor.
    Code-compliant: 0.165 m rise x 0.30 m tread, 1.2 m flight width, mid-landing.
    Each step is a box (visual = collision, R5). Humans use stairs; robots use the lift.
    Gazebo Classic 11 / SDF 1.6.
  </description>
</model>