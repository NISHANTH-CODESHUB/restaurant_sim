<?xml version="1.0" ?>
<!--
  window_standard | Module A - Structural Components
  Glazing: 1.5 m (X) x 1.2 m (Z), sill at z=0.9 (glass centre z=1.5).
  Frame depth matches exterior wall (0.25 m Y). Origin at wall centreline, floor level.
  R5: glass = visual only (no collision). Frame = thin box collisions.
-->
<sdf version="1.6">
  <model name="window_standard">
    <static>true</static>
    <link name="frame_link">
      <!-- Sill (below glass) fill: z 0.0 -> 0.9 -->
      <collision name="sill_col">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><box><size>1.7 0.25 0.9</size></box></geometry>
      </collision>
      <visual name="sill_vis">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><box><size>1.7 0.25 0.9</size></box></geometry>
        <material><ambient>0.85 0.84 0.80 1</ambient><diffuse>0.92 0.91 0.87 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        <transparency>0.85</transparency>
      </visual>

      <!-- Header (above glass): z 2.1 -> 3.0 -->
      <collision name="header_col">
        <pose>0 0 2.55 0 0 0</pose>
        <geometry><box><size>1.7 0.25 0.9</size></box></geometry>
      </collision>
      <visual name="header_vis">
        <pose>0 0 2.55 0 0 0</pose>
        <geometry><box><size>1.7 0.25 0.9</size></box></geometry>
        <material><ambient>0.85 0.84 0.80 1</ambient><diffuse>0.92 0.91 0.87 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        <transparency>0.85</transparency>
      </visual>

      <!-- Left mullion -->
      <collision name="mull_left_col">
        <pose>-0.85 0 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.25 1.2</size></box></geometry>
      </collision>
      <visual name="mull_left_vis">
        <pose>-0.85 0 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.25 1.2</size></box></geometry>
        <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.38 0.38 0.40 1</diffuse><specular>0.25 0.25 0.27 1</specular></material>
        <transparency>0.85</transparency>
      </visual>
      <!-- Right mullion -->
      <collision name="mull_right_col">
        <pose>0.85 0 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.25 1.2</size></box></geometry>
      </collision>
      <visual name="mull_right_vis">
        <pose>0.85 0 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.25 1.2</size></box></geometry>
        <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.38 0.38 0.40 1</diffuse><specular>0.25 0.25 0.27 1</specular></material>
        <transparency>0.85</transparency>
      </visual>
    </link>

    <!-- ===== GLASS (visual only) ===== -->
    <link name="glass_link">
      <pose>0 0 1.5 0 0 0</pose>
      <visual name="glass_vis">
        <geometry><box><size>1.5 0.03 1.2</size></box></geometry>
        <material>
          <!-- Cool tinted transparent glass -->
          <ambient>0.35 0.45 0.50 0.30</ambient>
          <diffuse>0.45 0.55 0.60 0.30</diffuse>
          <specular>0.70 0.70 0.72 0.30</specular>
        </material>
        <transparency>0.7</transparency>
      </visual>
    </link>
  </model>
</sdf>