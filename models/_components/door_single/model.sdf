<?xml version="1.0" ?>
<!--
  door_single | Module A - Structural Components
  Clear opening: 0.9 m (X) x 2.1 m (Z). Frame thickness matches interior wall (0.15 m Y).
  Origin: center of the doorway at floor level. Frame outer width = 0.9 + 2*0.08 = 1.06 m.
  Leaf modeled OPEN-FLAT against the frame (does not obstruct the 0.9 m path) for
  navigation-friendly static use. Convert 'leaf_link' to a revolute joint later for animation.
-->
<sdf version="1.6">
  <model name="door_single">
    <static>true</static>

    <!-- ===== FRAME ===== -->
    <link name="frame_link">
      <!-- Left jamb -->
      <collision name="jamb_left_col">
        <pose>-0.49 0 1.05 0 0 0</pose>
        <geometry><box><size>0.08 0.15 2.1</size></box></geometry>
      </collision>
      <visual name="jamb_left_vis">
        <pose>-0.49 0 1.05 0 0 0</pose>
        <geometry><box><size>0.08 0.15 2.1</size></box></geometry>
        <material>
          <ambient>0.28 0.18 0.10 1</ambient>
          <diffuse>0.35 0.22 0.12 1</diffuse>
          <specular>0.10 0.08 0.05 1</specular>
        </material>
      </visual>

      <!-- Right jamb -->
      <collision name="jamb_right_col">
        <pose>0.49 0 1.05 0 0 0</pose>
        <geometry><box><size>0.08 0.15 2.1</size></box></geometry>
      </collision>
      <visual name="jamb_right_vis">
        <pose>0.49 0 1.05 0 0 0</pose>
        <geometry><box><size>0.08 0.15 2.1</size></box></geometry>
        <material>
          <ambient>0.28 0.18 0.10 1</ambient>
          <diffuse>0.35 0.22 0.12 1</diffuse>
          <specular>0.10 0.08 0.05 1</specular>
        </material>
      </visual>

      <!-- Head / lintel (spans 0.9 clear + jambs, from z=2.1 up to 3.0 fill) -->
      <collision name="head_col">
        <pose>0 0 2.55 0 0 0</pose>
        <geometry><box><size>1.06 0.15 0.9</size></box></geometry>
      </collision>
      <visual name="head_vis">
        <pose>0 0 2.55 0 0 0</pose>
        <geometry><box><size>1.06 0.15 0.9</size></box></geometry>
        <material>
          <ambient>0.85 0.84 0.80 1</ambient>
          <diffuse>0.92 0.91 0.87 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- ===== LEAF (held open flat, no path obstruction) ===== -->
    <link name="leaf_link">
      <!-- Placed flush inside the reveal, offset in Y so it doesn't block the 0.9 m opening -->
      <pose>0 -0.06 1.05 0 0 0</pose>
      <collision name="leaf_col">
        <!-- Thin leaf; kept out of the walkway plane -->
        <geometry><box><size>0.86 0.04 2.05</size></box></geometry>
      </collision>
      <visual name="leaf_vis">
        <geometry><box><size>0.86 0.04 2.05</size></box></geometry>
        <material>
          <ambient>0.32 0.20 0.11 1</ambient>
          <diffuse>0.42 0.27 0.15 1</diffuse>
          <specular>0.15 0.12 0.08 1</specular>
        </material>
      </visual>
    </link>

    <!--
      FUTURE: replace the static leaf with an animated door:
      <joint name="hinge" type="revolute">
        <parent>frame_link</parent><child>leaf_link</child>
        <axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>1.57</upper></limit></axis>
      </joint>
      (requires <static>false</static> on this model)
    -->
  </model>
</sdf>