<?xml version="1.0" ?>
<!--
  door_double | Module A - Structural Components
  Clear opening: 1.5 m (X) x 2.1 m (Z). Frame in 0.15 m wall.
  Two 0.73 m leaves (leaf_left, leaf_right) as separate links, held flat, out of walkway.
-->
<sdf version="1.6">
  <model name="door_double">
    <static>true</static>
    <link name="frame_link">
      <collision name="jamb_left_col">
        <pose>-0.79 0 1.05 0 0 0</pose>
        <geometry><box><size>0.08 0.15 2.1</size></box></geometry>
      </collision>
      <visual name="jamb_left_vis">
        <pose>-0.79 0 1.05 0 0 0</pose>
        <geometry><box><size>0.08 0.15 2.1</size></box></geometry>
        <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse><specular>0.30 0.30 0.32 1</specular></material>
      </visual>
      <collision name="jamb_right_col">
