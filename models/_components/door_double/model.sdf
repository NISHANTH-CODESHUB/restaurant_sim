        <material><ambient>0.85 0.84 0.80 1</ambient><diffuse>0.92 0.91 0.87 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
    </link>

    <link name="leaf_left">
      <pose>-0.375 -0.06 1.05 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.70 0.04 2.05</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.70 0.04 2.05</size></box></geometry>
