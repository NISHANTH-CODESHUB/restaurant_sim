<?xml version="1.0" ?>
<!--
  ceiling_light_panel | Module C - Lighting
  Recessed 0.6 x 0.6 m LED panel. Include with pose z ~ 2.95 (just below ceiling at 3.0).
  Origin: centre of the diffuser face. NO collision (R5 - lights never need collision).
  Pairs an emissive diffuser visual (always reads as 'on', cheap) with one soft
  warm point light for actual illumination. Attenuation tuned for ~4 m room modules.
-->
<sdf version="1.6">
  <model name="ceiling_light_panel">
    <static>true</static>

    <link name="panel_link">
      <!-- Housing bezel -->
      <visual name="bezel_vis">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.66 0.66 0.04</size></box></geometry>
        <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse><specular>0.30 0.30 0.32 1</specular></material>
      </visual>
      <!-- Emissive diffuser face (warm white glow) -->
      <visual name="diffuser_vis">
        <pose>0 0 0.0 0 0 0</pose>
        <geometry><box><size>0.60 0.60 0.02</size></box></geometry>
        <material>
          <ambient>0.90 0.86 0.78 1</ambient>
          <diffuse>1.0 0.96 0.88 1</diffuse>
          <emissive>1.0 0.95 0.85 1</emissive>
        </material>
      </visual>

      <!-- Actual light source: warm, soft, downward -->
      <light name="panel_light" type="point">
        <pose>0 0 -0.05 0 0 0</pose>
        <diffuse>0.85 0.82 0.75 1</diffuse>
        <specular>0.25 0.24 0.22 1</specular>
        <attenuation>
          <range>7.0</range>
          <constant>0.4</constant>
          <linear>0.12</linear>
          <quadratic>0.02</quadratic>
        </attenuation>
        <cast_shadows>false</cast_shadows>
      </light>
    </link>
  </model>
</sdf>