<?xml version="1.0" ?>
<!--
  pendant_light | Module C - Lighting
  Decorative hanging pendant for over dining tables. Include with the pose placed
  at the CEILING (z ~ 3.0); the cord drops the shade to ~1.6 m over the table.
  Origin: at the ceiling anchor point. NO collision (R5) and shade is well above head/robot height.
  Emissive shade + one warm point light with tighter attenuation (intimate pool of light).
-->
<sdf version="1.6">
  <model name="pendant_light">
    <static>true</static>

    <link name="pendant_link">
      <!-- Cord (drops from ceiling z=0 down to shade top ~ -1.3) -->
      <visual name="cord_vis">
        <pose>0 0 -0.65 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>1.30</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>

      <!-- Shade (cone-like: use cylinder for Classic simplicity) -->
      <visual name="shade_vis">
        <pose>0 0 -1.40 0 0 0</pose>
        <geometry><cylinder><radius>0.16</radius><length>0.20</length></cylinder></geometry>
        <material><ambient>0.14 0.13 0.12 1</ambient><diffuse>0.20 0.18 0.16 1</diffuse><specular>0.35 0.33 0.30 1</specular></material>
      </visual>
      <!-- Emissive bulb / underside glow -->
      <visual name="bulb_vis">
        <pose>0 0 -1.52 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0.95 0.85 0.60 1</ambient>
          <diffuse>1.0 0.92 0.70 1</diffuse>
          <emissive>1.0 0.90 0.65 1</emissive>
        </material>
      </visual>

      <!-- Warm intimate light pooled over the table -->
      <light name="pendant_light_src" type="point">
        <pose>0 0 -1.55 0 0 0</pose>
        <diffuse>0.80 0.72 0.55 1</diffuse>
        <specular>0.20 0.18 0.14 1</specular>
        <attenuation>
          <range>4.0</range>
          <constant>0.5</constant>
          <linear>0.2</linear>
          <quadratic>0.05</quadratic>
        </attenuation>
        <cast_shadows>false</cast_shadows>
      </light>
    </link>
  </model>
</sdf>