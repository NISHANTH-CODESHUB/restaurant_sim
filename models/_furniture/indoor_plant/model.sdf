<?xml version="1.0" ?>
<!--
  indoor_plant | Module B - Furniture
  Decorative accent: cylindrical pot + spherical/box foliage, ~1.4 m tall.
  Origin: floor centre of the pot.
  R5: single cylinder collision covering pot + trunk footprint (foliage is soft,
      visual-only, so robots don't get blocked by leaves).
-->
<sdf version="1.6">
  <model name="indoor_plant">
    <static>true</static>
    <link name="plant_link">
      <!-- R5 collision: pot + trunk footprint only -->
      <collision name="pot_col">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
      </collision>

      <!-- Pot -->
      <visual name="pot_vis">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry><cylinder><radius>0.22</radius><length>0.40</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse><specular>0.30 0.30 0.32 1</specular></material>
      </visual>
      <!-- Trunk -->
      <visual name="trunk_vis">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry>
        <material><ambient>0.25 0.16 0.08 1</ambient><diffuse>0.35 0.22 0.11 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <!-- Foliage (visual only) -->
      <visual name="foliage_lower_vis">
        <pose>0 0 0.95 0 0 0</pose>
        <geometry><sphere><radius>0.35</radius></sphere></geometry>
        <material><ambient>0.08 0.22 0.08 1</ambient><diffuse>0.12 0.35 0.12 1</diffuse><specular>0.05 0.08 0.05 1</specular></material>
      </visual>
      <visual name="foliage_upper_vis">
        <pose>0 0 1.25 0 0 0</pose>
        <geometry><sphere><radius>0.27</radius></sphere></geometry>
        <material><ambient>0.09 0.26 0.09 1</ambient><diffuse>0.14 0.40 0.14 1</diffuse><specular>0.05 0.08 0.05 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>