<?xml version="1.0" ?>
<!--
  dining_table_6 | Module B - Furniture
  1.8 (X) x 0.9 (Y) m top at height 0.75 m. Origin: floor centre.
  Seats 6 (3 per long side). Chairs placed separately by cabin assembly.
  R5: collision = tabletop box + two solid trestle leg-panels (X ends).
-->
<sdf version="1.6">
  <model name="dining_table_6">
    <static>true</static>

    <link name="table_link">
      <!-- ===== R5 COLLISIONS ===== -->
      <collision name="top_col">
        <pose>0 0 0.73 0 0 0</pose>
        <geometry><box><size>1.8 0.9 0.05</size></box></geometry>
      </collision>
      <collision name="leg_left_col">
        <pose>-0.75 0 0.36 0 0 0</pose>
        <geometry><box><size>0.08 0.7 0.72</size></box></geometry>
      </collision>
      <collision name="leg_right_col">
        <pose>0.75 0 0.36 0 0 0</pose>
        <geometry><box><size>0.08 0.7 0.72</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>

      <!-- ===== VISUALS ===== -->
      <visual name="top_vis">
        <pose>0 0 0.73 0 0 0</pose>
        <geometry><box><size>1.8 0.9 0.05</size></box></geometry>
        <material>
          <ambient>0.32 0.22 0.12 1</ambient>
          <diffuse>0.48 0.33 0.18 1</diffuse>
          <specular>0.22 0.16 0.11 1</specular>
        </material>
      </visual>
      <visual name="leg_left_vis">
        <pose>-0.75 0 0.38 0 0 0</pose>
        <geometry><box><size>0.06 0.65 0.70</size></box></geometry>
        <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.18 0.18 0.19 1</diffuse><specular>0.35 0.35 0.37 1</specular></material>
      </visual>
      <visual name="leg_right_vis">
        <pose>0.75 0 0.38 0 0 0</pose>
        <geometry><box><size>0.06 0.65 0.70</size></box></geometry>
        <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.18 0.18 0.19 1</diffuse><specular>0.35 0.35 0.37 1</specular></material>
      </visual>
      <!-- Stretcher bar between legs -->
      <visual name="stretcher_vis">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>1.4 0.06 0.06</size></box></geometry>
        <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.18 0.18 0.19 1</diffuse><specular>0.35 0.35 0.37 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>