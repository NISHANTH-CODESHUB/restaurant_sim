<?xml version="1.0" ?>
<!--
  charging_dock | Module B - Furniture
  A single robot dock. Repeat x4 in the ground floor for multi-robot expansion.
  Floor pad (drivable, near-flush) + a short back unit (wall-mounted charger).
  Origin: floor centre of the pad. Robot docks facing -X into the back unit.
  'dock_frame': named frame = future Nav2 docking goal / charging behaviour target.
  R5: only the back unit has collision; the floor pad is visual-only (flush, drivable).
-->
<sdf version="1.6">
  <model name="charging_dock">
    <static>true</static>

    <link name="dock_link">
      <!-- Floor pad: VISUAL ONLY (drivable, no lip) -->
      <visual name="pad_vis">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry><box><size>0.9 0.9 0.01</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.12 1</ambient><diffuse>0.14 0.14 0.16 1</diffuse>
          <specular>0.10 0.10 0.12 1</specular>
        </material>
      </visual>
      <!-- Painted safety border (emissive cyan) -->
      <visual name="border_vis">
        <pose>0 0 0.006 0 0 0</pose>
        <geometry><box><size>0.95 0.95 0.008</size></box></geometry>
        <material>
          <ambient>0.05 0.30 0.35 1</ambient><diffuse>0.08 0.45 0.52 1</diffuse>
          <emissive>0.08 0.40 0.48 1</emissive>
        </material>
      </visual>

      <!-- Back charger unit: has collision -->
      <collision name="back_col">
        <pose>-0.50 0 0.35 0 0 0</pose>
        <geometry><box><size>0.15 0.6 0.7</size></box></geometry>
      </collision>
      <visual name="back_vis">
        <pose>-0.50 0 0.35 0 0 0</pose>
        <geometry><box><size>0.15 0.6 0.7</size></box></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse><specular>0.30 0.30 0.32 1</specular></material>
      </visual>
      <!-- Status indicator (emissive green = available) -->
      <visual name="status_vis">
        <pose>-0.42 0 0.55 0 0 0</pose>
        <geometry><box><size>0.02 0.15 0.08</size></box></geometry>
        <material>
          <ambient>0.05 0.40 0.10 1</ambient><diffuse>0.10 0.65 0.15 1</diffuse>
          <emissive>0.10 0.60 0.15 1</emissive>
        </material>
      </visual>
    </link>

    <!-- FUTURE docking goal: robot centred on pad, facing the back unit (-X) -->
    <frame name="dock_frame">
      <pose>0 0 0 0 0 3.14159</pose>
    </frame>
  </model>
</sdf>